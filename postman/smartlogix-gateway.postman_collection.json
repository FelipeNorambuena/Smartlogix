{
  "info": {
    "name": "SmartLogix - API Gateway",
    "description": "Coleccion para probar auth-service a traves del API Gateway. Usar cuando api-gateway esta levantado en http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Gateway Health",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": "{{gatewayUrl}}/actuator/health"
      }
    },
    {
      "name": "Auth por Gateway",
      "item": [
        {
          "name": "Registrar cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set('authToken', response.token);",
                  "  pm.collectionVariables.set('currentUserId', response.user.id);",
                  "  pm.collectionVariables.set('clientEmail', response.user.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente.gateway{{$timestamp}}@smartlogix.com\",\n  \"password\": \"Cliente12345\",\n  \"firstName\": \"Cliente\",\n  \"lastName\": \"Gateway\"\n}"
            },
            "url": "{{gatewayUrl}}/auth/register"
          }
        },
        {
          "name": "Login cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set('authToken', response.token);",
                  "  pm.collectionVariables.set('currentUserId', response.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{clientPassword}}\"\n}"
            },
            "url": "{{gatewayUrl}}/auth/login"
          }
        },
        {
          "name": "Login ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set('authToken', response.token);",
                  "  pm.collectionVariables.set('currentUserId', response.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{gatewayUrl}}/auth/login"
          }
        },
        {
          "name": "Perfil actual",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Users por Gateway - ADMIN",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/users"
          }
        },
        {
          "name": "Crear usuario operador inventario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set('targetUserId', response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"operador.gateway{{$timestamp}}@smartlogix.com\",\n  \"password\": \"Operador12345\",\n  \"firstName\": \"Operador\",\n  \"lastName\": \"Gateway\",\n  \"roles\": [\"OPERADOR_INVENTARIO\"],\n  \"enabled\": true\n}"
            },
            "url": "{{gatewayUrl}}/users"
          }
        },
        {
          "name": "Buscar usuario por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/users/{{targetUserId}}"
          }
        }
      ]
    },
    {
      "name": "Inventario por Gateway - ADMIN u OPERADOR_INVENTARIO",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/inventory/products?page={{page}}&size={{size}}"
          }
        },
        {
          "name": "Buscar producto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/inventory/products/{{productId}}"
          }
        },
        {
          "name": "Buscar producto por SKU",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/inventory/products/sku/{{sku}}"
          }
        },
        {
          "name": "Crear producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set('productId', response.id);",
                  "  pm.collectionVariables.set('sku', response.sku);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SLX-GW-{{$timestamp}}\",\n  \"name\": \"Producto Gateway\",\n  \"description\": \"Producto creado desde API Gateway\",\n  \"unitPrice\": 12990,\n  \"category\": \"Gateway\"\n}"
            },
            "url": "{{gatewayUrl}}/inventory/products"
          }
        },
        {
          "name": "Actualizar producto",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{sku}}\",\n  \"name\": \"Producto Gateway actualizado\",\n  \"description\": \"Producto actualizado desde API Gateway\",\n  \"unitPrice\": 13990,\n  \"category\": \"Gateway\",\n  \"active\": true\n}"
            },
            "url": "{{gatewayUrl}}/inventory/products/{{productId}}"
          }
        },
        {
          "name": "Listar inventario",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/inventory?page={{page}}&size={{size}}"
          }
        },
        {
          "name": "Crear o actualizar inventario por producto",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stockAvailable\": 20,\n  \"stockReserved\": 5,\n  \"warehouseLocation\": \"Santiago\",\n  \"reorderPoint\": 3\n}"
            },
            "url": "{{gatewayUrl}}/inventory/{{productId}}"
          }
        },
        {
          "name": "Consultar disponibilidad por cantidad",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/inventory/{{productId}}/availability?quantity={{quantity}}"
          }
        },
        {
          "name": "Reservar stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": {{quantity}}\n}"
            },
            "url": "{{gatewayUrl}}/inventory/{{productId}}/reserve"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "currentUserId",
      "value": ""
    },
    {
      "key": "targetUserId",
      "value": ""
    },
    {
      "key": "clientEmail",
      "value": "cliente@smartlogix.com"
    },
    {
      "key": "clientPassword",
      "value": "Cliente12345"
    },
    {
      "key": "adminEmail",
      "value": "admin@smartlogix.com"
    },
    {
      "key": "adminPassword",
      "value": "Admin12345"
    },
    {
      "key": "productId",
      "value": "00000000-0000-0000-0000-000000000000"
    },
    {
      "key": "sku",
      "value": "SLX-GW"
    },
    {
      "key": "quantity",
      "value": "4"
    },
    {
      "key": "page",
      "value": "0"
    },
    {
      "key": "size",
      "value": "20"
    }
  ]
}
